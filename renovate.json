{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>zekihan/renovate-config"
  ],
  "packageRules": [
    {
      "description": "Keep the verified base digest until its registry metadata is consistent.",
      "matchPackageNames": [
        "zekihan/distroless"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "enabled": false
    }
  ]
}
