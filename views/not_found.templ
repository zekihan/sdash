package views

templ NotFound() {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		@header()
		<body>
			<main>
				<div class="w-screen h-screen overflow-auto bg-white dark:bg-black p-4 md:p-6 2xl:p-10">
					<div class="text-center dark:text-white">
						<h1 class="text-4xl md:text-5xl 2xl:text-6xl font-bold">404</h1>
						<p class="text-lg md:text-xl 2xl:text-2xl">The page you are looking for does not exist.</p>
						<div class="mt-4">
							<a href="/" class="text-blue-500 hover:underline">Go back to home</a>
						</div>
					</div>
				</div>
			</main>
		</body>
	</html>
}
