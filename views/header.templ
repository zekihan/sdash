package views

templ header() {
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<script src="/assets/js/htmx@2.0.4.js"></script>
		<link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon.png"/>
		<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-32x32.png"/>
		<link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon/favicon-16x16.png"/>
		<link rel="manifest" href="/assets/favicon/site.webmanifest"/>
		@css()
		<title>Simple Dashboard</title>
	</head>
}

templ css() {
	<link rel="stylesheet" href="/assets/css/tailwind.min.css" onerror="this.onerror=null;this.href='/assets/css/tailwind.css'"/>
	<link rel="stylesheet" href="/assets/css/scroll.min.css" onerror="this.onerror=null;this.href='/assets/css/scroll.css'"/>
}
