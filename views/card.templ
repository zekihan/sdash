package views

script cardOnClick(a string) {
	console.log(a);
	window.open(a, '_blank')
}

templ card(icon string, text string, link string) {
	<div
		class="p-4 w-full max-w-sm"
	>
		<div
			class="flex w-full h-40 rounded-lg h-full dark:bg-gray-800 bg-teal-400 p-8 flex-col cursor-pointer "
			onclick={ cardOnClick(link) }
		>
			<div class="flex items-center justify-center">
				@image(icon, text)
			</div>
			<div class="mt-4">
				<p class="text-white text-lg title-font font-medium text-center">{ text }</p>
			</div>
		</div>
	</div>
}

templ image(icon string, title string) {
	if icon == "" {
		<div class="w-8 h-8 bg-gray-200 text-gray-400 rounded-full flex items-center justify-center">
			<h2 class="text-dark text-xlg title-font font-medium">{ string(title[0]) }</h2>
		</div>
	} else {
		<img src={ icon } alt="icon" class="w-8 h-8"/>
	}
}
