package views

templ Error() {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		@header()
		<body>
			<main>
				<div class="w-screen h-screen overflow-auto bg-white dark:bg-black p-4 md:p-6 2xl:p-10">
					<div class="text-center dark:text-white">
						<h1 class="text-4xl md:text-5xl 2xl:text-6xl font-bold">An error occurred 5xx</h1>
						<p class="text-lg md:text-xl 2xl:text-2xl">Something went wrong. Please try again later.</p>
					</div>
				</div>
			</main>
		</body>
	</html>
}
