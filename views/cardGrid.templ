package views

import (
	"fmt"
	"net/url"

	"github.com/zekihan/sdash/config/dashboard"
)

templ CardLists(config *dashboard.Config) {
	<div
		id="card-lists"
		class="container mx-auto"
	>
		<div class="space-y-10">
			for _, group := range config.GroupList {
				if group.HasAny {
					<div>
						<h1
							class="text-white text-lg title-font font-medium text-center cursor-pointer"
						>
							<a href={ templ.URL("/dashboard/group/" + url.PathEscape(group.Key)) }>{ group.Title }</a>
						</h1>
						@cardGrid(config, group)
					</div>
				}
			}
		</div>
	</div>
}

templ cardGrid(config *dashboard.Config, group *dashboard.Group) {
	<div
		id={ fmt.Sprintf("card-grid-%s", group.Key) }
		class="flex flex-wrap justify-center mt-10"
	>
		for _, service := range config.ServicesList {
			if service.Group == group.Key {
				@card(service)
			}
		}
	</div>
}
