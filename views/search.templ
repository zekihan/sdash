package views

templ search() {
	<script>
        function toggleSearch() {
            const searchBar = document.getElementById('search')
            if (searchBar){
                if (searchBar.classList.contains('hidden')) {
                    searchBar.classList.remove('hidden')
                }
                else {
                    searchBar.classList.add('hidden')
                }
                const searchInput = document.getElementById('search-input')
                if (searchInput) {
                    searchInput.focus()
                    scrollTo(0, 0)
                }
            }
        }
        document.addEventListener('keydown', function(event) {
            if ((event.ctrlKey || event.metaKey) && event.key === 'f') {
                toggleSearch()
                event.preventDefault();
            }
        });
    </script>
	<div
		class="flex items-center transition mx-auto p-4 md:p-6 2xl:p-8"
	>
		<button
			class="bg-blue-500 dark:bg-gray-800 text-white h-12 dark:text-white py-2 px-4 rounded-lg"
			onclick="toggleSearch()"
		>
			Search
		</button>
		<div
			id="search"
			class="hidden flex mx-auto px-4 md:px-6 2xl:px-8 w-full"
		>
			<div class="flex items-center space-x-4 w-full">
				<label class="w-full">
					<input
						id="search-input"
						class="w-full form-control px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-white dark:border-gray-700"
						type="search"
						name="search"
						placeholder="Begin Typing To Search Users..."
						hx-get="/api/search"
						hx-trigger="input changed delay:500ms, search"
						hx-target="#card-lists"
						hx-swap="outerHTML"
					/>
				</label>
			</div>
		</div>
	</div>
}
