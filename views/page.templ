package views

import (
	"github.com/zekihan/sdash/config"
	"github.com/zekihan/sdash/utils"
)

templ Page(config *config.DashboardConfig) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<script src="/assets/js/htmx.js"></script>
			<link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon.png">
      <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-32x32.png">
      <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon/favicon-16x16.png">
      <link rel="manifest" href="/assets/favicon/site.webmanifest">
			@CSS()
			<title>Simple Dashboard</title>
			<script>
                document.addEventListener('keydown', function(event) {
                    if ((event.ctrlKey || event.metaKey) && event.key === 'f') {
                        const searchBar = document.getElementById('search')
                        if (searchBar){
                            if (searchBar.classList.contains('hidden')) {
                                searchBar.classList.remove('hidden')
                            }
                            const searchInput = document.getElementById('search-input')
                            if (searchInput) {
                                searchInput.focus()
                                scrollTo(0, 0)
                            }
                        }
                        event.preventDefault();
                    }
                });
            </script>
		</head>
		<body>
			<main>
				<div class="w-screen h-screen overflow-auto bg-white dark:bg-black p-4 md:p-6 2xl:p-10">
					@Search()
					@CardGrid(config)
				</div>
			</main>
		</body>
	</html>
}

templ Search() {
	<div
		id="search"
		class="hidden flex mx-auto p-4 md:p-6 2xl:p-8"
	>
		<div class="flex items-center space-x-4 w-full">
			<label class="w-full">
				<input
					id="search-input"
					class="w-full form-control px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-800 dark:text-white dark:border-gray-700"
					type="search"
					name="search"
					placeholder="Begin Typing To Search Users..."
					hx-get="/api/search"
					hx-trigger="input changed delay:500ms, search"
					hx-target="#card-grid"
					hx-swap="outerHTML"
				/>
			</label>
		</div>
	</div>
}

templ CardGrid(config *config.DashboardConfig) {
	<div
		id="card-grid"
		class="flex flex-wrap justify-center mt-10"
	>
		for _, service := range config.GetServices() {
			@card(service.Key, service.Icon, service.Title, service.URL)
		}
	</div>
}

templ CSS() {
	if utils.IsProduction() {
		<link rel="stylesheet" href="/assets/css/tailwind.min.css"/>
		<link rel="stylesheet" href="/assets/css/scroll.min.css"/>
	} else {
		<link rel="stylesheet" href="/assets/css/tailwind.css"/>
		<link rel="stylesheet" href="/assets/css/scroll.css"/>
	}
}
