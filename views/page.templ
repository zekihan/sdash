package views

import "github.com/zekihan/sdash/config"

templ Page(config *config.DashboardConfig) {
	<!DOCTYPE html>
	<html lang="en" class="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<script src="/assets/js/htmx.js"></script>
			<link rel="stylesheet" href="/assets/css/tailwind.css"/>
			<title>Simple Dashboard</title>
		</head>
		<body>
			<main>
				<div class="dark w-full h-screen overflow-hidden bg-white dark:bg-black max-w-screen-2xl p-4 md:p-6 2xl:p-10">
                    @Search()
                    @CardGrid(config)
				</div>
			</main>
		</body>
	</html>
}

templ Search() {
	<div class="flex mx-auto max-w-screen-2xl p-2 md:p-3 2xl:p-4">
		<div class="flex items-center space-x-2">
			<label>
				<input
					class="form-control"
					type="search"
					name="search"
					placeholder="Begin Typing To Search Users..."
					hx-get="/api/search"
					hx-trigger="input changed delay:500ms, search"
					hx-target="#card-grid"
				/>
			</label>
		</div>
	</div>
}

templ CardGrid(config *config.DashboardConfig) {
	<div
		id="card-grid"
		class="flex flex-wrap justify-center mt-10"
	>
		for _, service := range config.Services {
			@card(service.Icon, service.Title, service.URL)
		}
	</div>
}
